{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hslivemap",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "MARKERS_KV",
      "id": "eea069bbbf23474d907a3cf8c436ebf9"
    }
  ]
}
